# Copy to backend/.env and fill in real values. .env is gitignored —
# never commit real secrets.

# Port the ingest/read API listens on. NOTE: if the demo range
# (demo/docker-compose.yml) is up, port 8080 is already taken by the
# openemr container — use something else (e.g. 8090) while the range is
# running, or stop the range first.
PORT=8080

# Shared static API key the sensor agent sends as "Authorization: ApiKey <key>".
# Must match the api_key set in agents/sensor-agent/config/sensor-agent.toml
# (or demo/range/monitoring-agent/sensor-agent.toml for the demo range).
MEDWATCH_API_KEY=change-me

# SQLite file path. Use ":memory:" for a throwaway demo run (data lost on
# restart) or a real path to persist across restarts.
MEDWATCH_DB_PATH=./data/medwatch.sqlite

# Sanity cap on how many docs one ingest POST may contain.
MEDWATCH_MAX_BATCH_SIZE=5000
